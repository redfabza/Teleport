-- ฟังก์ชันสำหรับเสกไอเทม
GiveTPToolBtn.MouseButton1Click:Connect(function()
    local mouse = LocalPlayer:GetMouse()
    local tool = Instance.new("Tool")
    
    tool.RequiresHandle = false
    tool.Name = TOOL_NAME
    
    tool.Activated:Connect(function()
        local pos = mouse.Hit + Vector3.new(0, 2.5, 0)
        pos = CFrame.new(pos.X, pos.Y, pos.Z)
        
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = pos
        end
    end)
    
    tool.Parent = LocalPlayer.Backpack
    
    GiveTPToolBtn.Text = "✅ เสกไอเทมสำเร็จ!"
    task.wait(1)
    GiveTPToolBtn.Text = "🛠️ เสกเครื่องมือคลิกวาร์ป"
end)

-- ฟังก์ชันสำหรับลบไอเทมออกจากตัว
RemoveTPToolBtn.MouseButton1Click:Connect(function()
    local removedCount = 0
    
    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") and item.Name == TOOL_NAME then
            item:Destroy()
            removedCount = removedCount + 1
        end
    end
    
    if LocalPlayer.Character then
        for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
            if item:IsA("Tool") and item.Name == TOOL_NAME then
                item:Destroy()
                removedCount = removedCount + 1
            end
        end
    end
    
    if removedCount > 0 then
        RemoveTPToolBtn.Text = "✅ ลบไอเทมเรียบร้อย!"
    else
        RemoveTPToolBtn.Text = "💨 ไม่พบไอเทมในตัว"
    end
    task.wait(1)
    RemoveTPToolBtn.Text = "❌ ลบเครื่องมือคลิกวาร์ป"
end)

